[Unit]
Description=SPMAG Wifi Photo Receiver (Sony Send to Computer)
Documentation=https://github.com/aspidovss/spmag-sony-pm-alt-gui
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=spmag-wpr
Group=spmag-wpr
Environment=XDG_CONFIG_HOME=/var/lib/spmag-wpr
EnvironmentFile=-/etc/default/spmag-wpr
StateDirectory=spmag-wpr
ExecStart=/usr/bin/wpr watch $WPR_OPTS
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
# Further hardening. The receiver only needs the network (IPv4/IPv6 and
# netlink for the interface list), its state directory and the photo folder.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
